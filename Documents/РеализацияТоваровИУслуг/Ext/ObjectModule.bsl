
Процедура ОбработкаПроведения(Отказ, Режим)

	// запись в конце проведения
	Движения.ТоварыНаСкладах.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Движения.ЗаказыКлиентов.Записывать = Истина;
	Движения.УчетЗатрат.Записывать = Истина;

	// услуги только в продажи, суммой из документа (в затраты их не пишем)
	Для Каждого ТекСтрокаУслуги Из Услуги Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаУслуги.Услуга;
		Движение.Сотрудник = Сотрудник;
		Движение.Клиент = Клиент;
		Движение.Сумма = ТекСтрокаУслуги.Сумма;
	КонецЦикла;

	// Старая методика. блокируем склада и запись набора до чтения остатков ,
	// чтобы при перепроведении старые движения этого документа не остались в остатке
	Движения.ТоварыНаСкладах.БлокироватьДляИзменения = Истина;
	Движения.ТоварыНаСкладах.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеализацияТоваровИУслугТовары.Товар КАК Товар,
	               |	СУММА(РеализацияТоваровИУслугТовары.Количество) КАК Количество
	               |ПОМЕСТИТЬ ВТ_Товары
	               |ИЗ
	               |	Документ.РеализацияТоваровИУслуг.Товары КАК РеализацияТоваровИУслугТовары
	               |ГДЕ
	               |	РеализацияТоваровИУслугТовары.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РеализацияТоваровИУслугТовары.Товар
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_Товары.Товар КАК Товар,
	               |	ВТ_Товары.Количество КАК Количество,
	               |	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	               |	ЕСТЬNULL(ТоварыНаСкладахОстатки.СуммаОстаток, 0) КАК СуммаОстаток
	               |ИЗ
	               |	ВТ_Товары КАК ВТ_Товары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(&МоментВремени, Склад = &Склад) КАК ТоварыНаСкладахОстатки
	               |		ПО ВТ_Товары.Товар = ТоварыНаСкладахОстатки.Номенклатура";

	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Склад", Склад);
	ТаблицаТовары = Запрос.Выполнить().Выгрузить();

	// копим себестоимость по статьям
	ТаблицаЗатрат = Новый ТаблицаЗначений;
	ТаблицаЗатрат.Колонки.Добавить("СтатьяЗатрат");
	ТаблицаЗатрат.Колонки.Добавить("Сумма");

	Для Каждого ТекСтрокаТовары Из Товары Цикл
		СтрокаОстатка = ТаблицаТовары.Найти(ТекСтрокаТовары.Товар, "Товар");
		// Если не хватает товара тогда проведение отменяем и строку не списываем
		// цифра в тексте-  на сколько не хватает, количество строки - остаток
		Если ТекСтрокаТовары.Количество > СтрокаОстатка.КоличествоОстаток Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = "Указанное количество номенклатуры """
			+ ТекСтрокаТовары.Товар
			+ """ превышает остаток на "
			+ (ТекСтрокаТовары.Количество - СтрокаОстатка.КоличествоОстаток);
			Сообщение.Сообщить();
			Продолжить;
		КонецЕсли;

		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовары.Товар;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаТовары.Количество;

		// Средняя цена= сумма остатка/количество остатка
		// остаток забираем суммой остатка
		Если СтрокаОстатка.КоличествоОстаток = 0 Тогда
			СуммаСписания = 0;
		ИначеЕсли ТекСтрокаТовары.Количество = СтрокаОстатка.КоличествоОстаток Тогда
			СуммаСписания = СтрокаОстатка.СуммаОстаток;
		Иначе
			СуммаСписания = ТекСтрокаТовары.Количество * СтрокаОстатка.СуммаОстаток / СтрокаОстатка.КоличествоОстаток;
		КонецЕсли;

		Движение.Сумма = СуммаСписания;

		// Уменьшаем остаток в таблице
		СтрокаОстатка.КоличествоОстаток = СтрокаОстатка.КоличествоОстаток - ТекСтрокаТовары.Количество;
		СтрокаОстатка.СуммаОстаток = СтрокаОстатка.СуммаОстаток - СуммаСписания;

		// Статья из карточки товара (сумма себестоимости)
		НоваяСтрокаЗатрат = ТаблицаЗатрат.Добавить();
		НоваяСтрокаЗатрат.СтатьяЗатрат = ТекСтрокаТовары.Товар.СтатьяЗатрат;
		НоваяСтрокаЗатрат.Сумма = СуммаСписания;

		// В продажах выручка из строки документа
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Номенклатура = ТекСтрокаТовары.Товар;
		Движение.Сотрудник = Сотрудник;
		Движение.Клиент = Клиент;
		Движение.Сумма = ТекСтрокаТовары.Сумма;

	КонецЦикла;

	ТаблицаЗатрат.Свернуть("СтатьяЗатрат", "Сумма");

	// Регистр оборотов (вида движения нет)
	Для Каждого СтрокаЗатрат Из ТаблицаЗатрат Цикл
		Движение = Движения.УчетЗатрат.Добавить();
		Движение.Период = Дата;
		Движение.СтатьяЗатрат = СтрокаЗатрат.СтатьяЗатрат;
		Движение.Сумма = СтрокаЗатрат.Сумма;
	КонецЦикла;

	Если ЗначениеЗаполнено(Основание) Тогда
		Движение = Движения.ЗаказыКлиентов.Добавить();
		Движение.Период = Дата;
		Движение.Клиент = Клиент;
		Движение.ЗаписьКлиента = Основание;
		Движение.СуммаФакт = Услуги.Итог("Сумма");
	КонецЕсли;

КонецПроцедуры    

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	// Заполнение шапки
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаписьКлиента") Тогда
		Клиент = ДанныеЗаполнения.Клиент;
		Комментарий = ДанныеЗаполнения.Комментарий;
		Сотрудник = ДанныеЗаполнения.Сотрудник;
		Основание = ДанныеЗаполнения;
		Для Каждого ТекСтрокаУслуги Из ДанныеЗаполнения.Услуги Цикл
			НоваяСтрока = Услуги.Добавить();
			НоваяСтрока.Сумма = ТекСтрокаУслуги.Стоимость;
			НоваяСтрока.Услуга = ТекСтрокаУслуги.Услуга;
		КонецЦикла;
	КонецЕсли;  
	
КонецПроцедуры

