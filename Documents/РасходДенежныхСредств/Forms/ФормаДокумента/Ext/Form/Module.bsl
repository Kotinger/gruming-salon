&НаКлиенте
Процедура УстановитьВидимость()

	ВыдачаПодотчетнику = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходаДенег.ВыдачаДенегПодотчетнику"));
	ВзносВБанк = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийРасходаДенег.ВзносНаличнымиВБанк"));

	// договор прячем у подотчетникау взноса в банк и если получатель клиент
	Элементы.ДоговорКонтрагента.Видимость = Не ВыдачаПодотчетнику И Не ВзносВБанк И Не ПолучательЭтоКлиент(Объект.Получатель);

	// кого можно выбрать получателем
	Если ВыдачаПодотчетнику Тогда
		Элементы.Получатель.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Сотрудники");
	ИначеЕсли ВзносВБанк Тогда
		Элементы.Получатель.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Банки");
	Иначе
		Элементы.Получатель.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	КонецЕсли;

	// скрытый договор если заполнен стираем
	Если Не Элементы.ДоговорКонтрагента.Видимость И ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		Объект.ДоговорКонтрагента = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	УстановитьВидимость(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент) 
	
	УстановитьВидимость();   
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательПриИзменении(Элемент)
	
	УстановитьВидимость();    
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучательЭтоКлиент(Получатель)

	// тип контрагента в карточке
	Если ТипЗнч(Получатель) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Получатель.ТипКонтрагента = Перечисления.ТипыКонтрагентов.Клиент;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Ответственный 
	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
КонецПроцедуры
