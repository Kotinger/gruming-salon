&НаКлиенте
Процедура УстановитьВидимость()

	// наличные касса / безнал терминал
	Элементы.Касса.Видимость = (Объект.ТипДенежныхСредств = ПредопределенноеЗначение("Перечисление.ТипыДенежныхСредств.Наличные"));
	Элементы.ЭквайринговыйТерминал.Видимость = (Объект.ТипДенежныхСредств = ПредопределенноеЗначение("Перечисление.ТипыДенежныхСредств.Безналичные"));

	ВозвратОтПодотчетника = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступленияДенег.ВозвратОтПодотчетника"));
	ПолучениеНаличныхВБанке = (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПоступленияДенег.ПолучениеНаличныхВБанке"));

	// договор прячем у подотчетника, у банка и если плательщик клиент
	Элементы.ДоговорКонтрагента.Видимость = Не ВозвратОтПодотчетника И Не ПолучениеНаличныхВБанке И Не ПлательщикЭтоКлиент(Объект.Плательщик);

	// кого можно выбрать плательщиком
	Если ВозвратОтПодотчетника Тогда
		Элементы.Плательщик.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Сотрудники");
	ИначеЕсли ПолучениеНаличныхВБанке Тогда
		Элементы.Плательщик.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Банки");
	Иначе
		// оплата от покупателя и возврат от поставщика: только контрагенты
		Элементы.Плательщик.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	КонецЕсли;

	// плательщик другого типа после смены операции стираем
	Если ЗначениеЗаполнено(Объект.Плательщик)
		И Элементы.Плательщик.ОграничениеТипа.Типы().Найти(ТипЗнч(Объект.Плательщик)) = Неопределено Тогда
		Объект.Плательщик = Неопределено;
	КонецЕсли;

	// если скрытое и уже заполненное тогда стираем
	Если Не Элементы.Касса.Видимость И ЗначениеЗаполнено(Объект.Касса) Тогда
		Объект.Касса = ПредопределенноеЗначение("Справочник.Кассы.ПустаяСсылка");
	КонецЕсли;

	Если Не Элементы.ЭквайринговыйТерминал.Видимость И ЗначениеЗаполнено(Объект.ЭквайринговыйТерминал) Тогда
		Объект.ЭквайринговыйТерминал = ПредопределенноеЗначение("Справочник.ЭквайринговыеТерминалы.ПустаяСсылка");
	КонецЕсли;

	Если Не Элементы.ДоговорКонтрагента.Видимость И ЗначениеЗаполнено(Объект.ДоговорКонтрагента) Тогда
		Объект.ДоговорКонтрагента = ПредопределенноеЗначение("Справочник.ДоговорыКонтрагентов.ПустаяСсылка");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	УстановитьВидимость(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ТипДенежныхСредствПриИзменении(Элемент)
	
	УстановитьВидимость();  
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент) 
	
	УстановитьВидимость(); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикПриИзменении(Элемент) 
	
	УстановитьВидимость(); 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПлательщикЭтоКлиент(Плательщик)

	// тип контрагента в карточке, с формы его не видно
	Если ТипЗнч(Плательщик) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Плательщик.ТипКонтрагента = Перечисления.ТипыКонтрагентов.Клиент;

КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// пустого заполняем, кто уже стоит того не трогаем
	Если Не ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;

КонецПроцедуры