
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимость();  
	//из урока, логично было бы не менять заполненные
    Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
		СформироватьНаименованиеДоговора();
	КонецЕсли;;
КонецПроцедуры

&НаКлиенте
Процедура ПризнакБессрочногоДоговораПриИзменении(Элемент)
	УстановитьВидимость();
	СформироватьНаименованиеДоговора();
КонецПроцедуры   

&НаКлиенте
Процедура ВнешнийНомерДоговораПриИзменении(Элемент)
	СформироватьНаименованиеДоговора();
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗаключенияДоговораПриИзменении(Элемент)
	СформироватьНаименованиеДоговора();
КонецПроцедуры


&НаКлиенте
Процедура УстановитьВидимость()
	Если Объект.ПризнакБессрочногоДоговора Тогда
		Элементы.СрокДействияДоговора.Видимость = Ложь;
	    //Сделал как в уроке(если уже заполнено)
		Если ЗначениеЗаполнено(Объект.СрокДействияДоговора) Тогда
			Объект.СрокДействияДоговора = '0001,01,01';
		КонецЕсли;	
	Иначе
	    Элементы.СрокДействияДоговора.Видимость = Истина;
	КонецЕсли;
КонецПроцедуры    
//ну изходя из тз версия код из урока не подходит
//!в примере формы - нет времени, у меня без Формата появляется время
//!оператор + переводит установленный формат в строку (а там 00.00.00) 
//еще тут можно поиграть с пробелами, в задание нет по этому не делаю
&НаКлиенте    
Процедура СформироватьНаименованиеДоговора()
	Если ЗначениеЗаполнено(Объект.ВнешнийНомерДоговора)
		И ЗначениеЗаполнено(Объект.ДатаЗаключенияДоговора) Тогда
		Объект.Наименование = "№ "
		+ Объект.ВнешнийНомерДоговора
		+ " от "
		+ Формат(Объект.ДатаЗаключенияДоговора, "ДФ=dd.MM.yyyy") 
		+ " г.";
	КонецЕсли;
КонецПроцедуры

